{
  "name": "supermd",
  "version": "1.12.0",
  "description": "A universal anti-slop system prompt for any profession. One command installs it into Claude Code, Codex, Cursor and 15+ other agent harnesses; also a slop linter and an MCP server. Pure Markdown, bilingual EN/ID, zero dependencies.",
  "type": "module",
  "bin": {
    "supermd": "bin/supermd.mjs"
  },
  "exports": {
    "./compose": "./lib/compose.mjs",
    "./slop-scan": "./lib/slop-scan.mjs",
    "./harnesses": "./lib/harnesses.mjs",
    "./mcp": "./lib/mcp.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "eval": "node eval/run-eval.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "en/",
    "id/",
    "eval/lexicon.json",
    "RESEARCH.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "system-prompt",
    "prompt-engineering",
    "anti-slop",
    "llm",
    "ai-writing",
    "prompt",
    "cli",
    "linter",
    "bilingual",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "cursor",
    "windsurf",
    "copilot",
    "gemini-cli",
    "agents-md",
    "mcp",
    "mcp-server",
    "ai-agents"
  ],
  "homepage": "https://github.com/TegarTheGreat/SuperMD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TegarTheGreat/SuperMD.git"
  },
  "bugs": {
    "url": "https://github.com/TegarTheGreat/SuperMD/issues"
  },
  "author": "Tegar Prayuda (TegarTheGreat)",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=18"
  }
}
